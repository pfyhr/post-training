# tools/local.env: your own publishing setup. Copy this file to tools/local.env (git-ignored) and fill it in.
# LIB is where the Jellyfin music library is mounted on this machine; the encode runs over ssh on JELLYFIN_HOST,
# where the same library lives under LIB_REMOTE_PREFIX instead of LIB_LOCAL_PREFIX.
JELLYFIN_HOST=media-server
LIB=/Volumes/music-share/music
LIB_LOCAL_PREFIX=/Volumes/music-share
LIB_REMOTE_PREFIX=/srv/music-share
# Your copy of deckard's single, if you have one (it is re-tagged with full credits, never uploaded anywhere).
SINGLE=
